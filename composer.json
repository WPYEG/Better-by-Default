{
  "name": "wpyeg/sane-defaults",
  "description": "A teaching plugin for explicit, testable WordPress defaults",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml",
    "lint:fix": "phpcbf --standard=phpcs.xml",
    "test": "php tests/plugin-policy.php",
    "build": "php bin/build-zip.php",
    "build:deck": "cd workshop && node build_deck.js",
    "verify:dist": "php bin/build-zip.php --check",
    "verify:deck": "php bin/verify-deck.php",
    "verify:pdf": "php bin/verify-pdf.php",
    "verify:handout": "php bin/verify-handout.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
