<?xml version="1.0"?>
<ruleset name="Better by Default">
	<description>WordPress Coding Standards.</description>
	<file>plugin/sane-defaults</file>
	<file>tests</file>
	<file>bin</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php" />
	<arg name="parallel" value="8" />
	<rule ref="WordPress" />
	<!--
		tests/ and bin/ are CLI scripts, not WordPress runtime code: they report
		through STDOUT/STDERR and read the source tree directly, so the WP
		filesystem-API and i18n rules do not apply to them.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<!--
		verify-pdf.php shells out to LibreOffice and builds into a temporary
		directory it then removes. WP_Filesystem and wp_delete_file() are not
		available to a script that runs outside WordPress, and the whole point
		of this one is to invoke an external converter.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_exec">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.unlink_unlink">
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<!--
		The plugin is deliberately one readable file — that is the teaching
		point, and the README, the workshop deck, and the mu-plugin instructions
		all rely on it. Both of these sniffs want it split up: one demands the
		file be renamed class-wpyeg-blocked-xmlrpc-server.php after a class
		declared lazily inside a filter callback, the other allows only a single
		object structure per file. Neither fits a single-file plugin.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>plugin/sane-defaults/sane-defaults.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>plugin/sane-defaults/sane-defaults.php</exclude-pattern>
	</rule>
	<!--
		The $class parameter name mirrors core's wp_xmlrpc_server_class filter
		signature. Renaming it for the sniff would make the callback harder to
		match against the hook it implements.
	-->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames.classFound">
		<exclude-pattern>plugin/sane-defaults/sane-defaults.php</exclude-pattern>
	</rule>
</ruleset>
